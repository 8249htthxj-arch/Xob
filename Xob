function gInitHero(games){
  const scroller=document.getElementById('gHeroScroller');
  const dotsEl=document.getElementById('gHeroDots');
  scroller.querySelectorAll('.hero-slide').forEach(s=>s.remove());
  dotsEl.innerHTML='';
  gHeroGames=games; gHeroIdx=0;
  games.forEach((g,i)=>{
    const slide=gBuildHeroSlide(g); scroller.insertBefore(slide,dotsEl);
    const dot=document.createElement('div'); dot.className='hero-dot'+(i===0?' active':'');
    dot.addEventListener('click',()=>gGoHeroSlide(i)); dotsEl.appendChild(dot);
  });
  gShowHeroSlide(0); gStartHeroTimer();
}

function gShowHeroSlide(idx){
  document.querySelectorAll('#gHeroScroller .hero-slide').forEach((s,i)=>s.classList.toggle('active',i===idx));
  document.querySelectorAll('#gHeroDots .hero-dot').forEach((d,i)=>d.classList.toggle('active',i===idx));
  gHeroIdx=idx; gResetHeroProgress();
}
function gGoHeroSlide(idx){if(gHeroRaf)cancelAnimationFrame(gHeroRaf);gShowHeroSlide(idx);gStartHeroTimer();}
function gResetHeroProgress(){document.getElementById('gHeroProgress').style.width='0%';}
function gStartHeroTimer(){
  const progEl=document.getElementById('gHeroProgress');
  const start=performance.now();
  gHeroRaf=requestAnimationFrame(function tick(now){
    const pct=Math.min((now-start)/G_HERO_DURATION*100,100);
    progEl.style.width=pct+'%';
    if(pct<100){gHeroRaf=requestAnimationFrame(tick);}
    else{progEl.style.width='0%';gShowHeroSlide((gHeroIdx+1)%gHeroGames.length);gStartHeroTimer();}
  });
}

function gBuildRows(){
  const rowsSec=document.getElementById('gRowsSection');
  const sections=document.querySelectorAll('#sections-container .letter-section');
  if(!sections.length) return;
  rowsSec.innerHTML=''; gAllGames=[];
  sections.forEach(section=>{
    const hdr=section.querySelector('.letter-header');
    const btns=section.querySelectorAll('input[type="button"]');
    if(!hdr||!btns.length) return;
    const label=hdr.textContent.trim();
    const games=Array.from(btns).map(btn=>({name:gCleanName(btn.value),btn}));
    gAllGames.push(...games);
    const rowId='gr-'+label.replace(/\W/g,'_');
    const row=document.createElement('div'); row.className='row';
    row.innerHTML=`<div class="row-header"><span class="row-title">${label}</span><span class="row-count">${games.length} games</span><div class="row-title-line"></div></div>
      <div class="row-scroll-wrap">
        <button class="row-arrow left" onclick="gScrollRow('${rowId}',-1)">&#8249;</button>
        <div class="row-scroll" id="${rowId}"></div>
        <button class="row-arrow right" onclick="gScrollRow('${rowId}',1)">&#8250;</button>
      </div>`;
    const scrollEl=row.querySelector('.row-scroll');
    games.forEach(g=>scrollEl.appendChild(gMakeCard(g)));
    rowsSec.appendChild(row);
  });
  if(gAllGames.length){
    const shuffled=[...gAllGames].sort(()=>Math.random()-0.5);
    gInitHero(shuffled.slice(0,8));
  }
}
window.gScrollRow=(id,dir)=>{const el=document.getElementById(id);if(el)el.scrollBy({left:dir*700,behavior:'smooth'});};

document.getElementById('gSearchInput').addEventListener('input',()=>{
  const q=document.getElementById('gSearchInput').value.trim().toLowerCase();
  const sr=document.getElementById('gSearchResults'); const rs=document.getElementById('gRowsSection'); const hs=document.getElementById('gHeroScroller');
  if(!q){sr.classList.remove('active');rs.style.display='';hs.style.display='';return;}
  const matches=gAllGames.filter(g=>g.name.toLowerCase().includes(q));
  hs.style.display='none'; rs.style.display='none'; sr.classList.add('active');
  document.getElementById('gSrLabel').textContent=`"${q}"`;
  document.getElementById('gSrSub').textContent=matches.length?`${matches.length} game${matches.length===1?'':'s'} found`:'No games matched.';
  const grid=document.getElementById('gSearchGrid'); grid.innerHTML='';
  matches.forEach(g=>grid.appendChild(gMakeCard(g)));
});


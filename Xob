function gMakeCard(game){
  const letter=(game.name.charAt(0)||'?').toUpperCase();
  const pal=gGetPal(game.name);
  const card=document.createElement('div'); card.className='gcard';
  card.style.setProperty('--gcard-accent',pal.accent);
  card.style.background=`linear-gradient(160deg,${pal.top} 0%,${pal.mid} 60%,${pal.bot} 100%)`;
  card.innerHTML=`<div class="gcard-art" style="background:linear-gradient(160deg,${pal.top} 0%,${pal.mid} 60%,${pal.bot} 100%)">
      <div class="gcard-shape1"></div><div class="gcard-shape2"></div>

function vGoHero(index) {
  if (index >= vHeroShows.length) index = 0;
  if (index < 0) index = vHeroShows.length - 1;
  vHeroIndex = index;

  const show = vHeroShows[vHeroIndex];
  
  // Updating the VideoBox Hero Elements
  const hero = document.getElementById('vHero');
  if (hero) {
    hero.style.backgroundImage = `url('${show.backdrop}')`;
    document.getElementById('vHeroTitle').textContent = show.title;
    document.getElementById('vHeroDesc').textContent = show.description;
  }

  clearTimeout(vHeroTimer);
  // Uses the same timing constant as your movies if you have one
  vHeroTimer = setTimeout(() => vGoHero(vHeroIndex + 1), 5000); 
}

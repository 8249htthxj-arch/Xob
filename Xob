const cCategories = [
  { label: "All Books", filter: () => true },
  { label: "Comics", filter: b => /comic/i.test(b.genre) },
  { label: "Manga", filter: b => /manga/i.test(b.genre) },
  { label: "Novels", filter: b => /novel/i.test(b.genre) },
];

let cHeroIndex = 0, cHeroTimer = null;
const C_HERO_DURATION = 8000;

function initComics() {
  const slidesEl = document.getElementById('cHeroSlides');
  const dotsEl = document.getElementById('cHeroDots');
  cBooks.forEach((b, i) => {
    const slide = document.createElement('div');
    slide.className = 'c-hero-slide' + (i === 0 ? ' active' : '');
    slide.style.backgroundImage = `url('${b.backdrop}')`;
    slidesEl.appendChild(slide);
    const dot = document.createElement('button');
    dot.className = 'c-hero-dot' + (i === 0 ? ' active' : '');
    dot.addEventListener('click', () => cGoHero(i));
    dotsEl.appendChild(dot);
  });
  cShowHero(0);
  cResetProgress();
  document.getElementById('cHeroPrev').addEventListener('click', () => cGoHero(cHeroIndex - 1));
  document.getElementById('cHeroNext').addEventListener('click', () => cGoHero(cHeroIndex + 1));
  cBuildRows();
  document.getElementById('cSearchInput').addEventListener('input', cDoSearch);
  document.getElementById('cModalClose').addEventListener('click', cCloseModal);
  document.getElementById('cModalOverlay').addEventListener('click', e => {
    if (e.target === document.getElementById('cModalOverlay')) cCloseModal();
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && activeTab === 'comics') cCloseModal();
  });
}

function cShowHero(idx) {
  cHeroIndex = (idx + cBooks.length) % cBooks.length;
  const b = cBooks[cHeroIndex];
  document.querySelectorAll('#cHeroSlides .c-hero-slide').forEach((el, i) => el.classList.toggle('active', i === cHeroIndex));
  document.querySelectorAll('#cHeroDots .c-hero-dot').forEach((el, i) => el.classList.toggle('active', i === cHeroIndex));
  document.getElementById('cHeroTitle').textContent = b.title;
  document.getElementById('cHeroYear').textContent = b.year;
  document.getElementById('cHeroGenre').textContent = b.genre;
  document.getElementById('cHeroDesc').textContent = b.description;
  document.getElementById('cHeroReadBtn').onclick = () => cOpenModal(b);
  document.getElementById('cHeroInfoBtn').onclick = () => cOpenModal(b);
}

function cGoHero(idx) { cShowHero(idx); cResetProgress(); }

function cResetProgress() {
  clearTimeout(cHeroTimer);
  const bar = document.getElementById('cHeroProgressBar');
  bar.style.transition = 'none'; bar.style.width = '0%'; bar.offsetHeight;
  bar.style.transition = `width ${C_HERO_DURATION}ms linear`; bar.style.width = '100%';
  cHeroTimer = setTimeout(() => cGoHero(cHeroIndex + 1), C_HERO_DURATION);
}

function cMakeCard(book) {
  const card = document.createElement('div');
  card.className = 'c-card';
  const volCount = Object.keys(book.chapters).length;
  const pageCount = Object.values(book.chapters).reduce((a, s) => a + s.length, 0);
  card.innerHTML = `
    <img class="c-card-poster" src="${book.poster}" alt="${book.title}" loading="lazy" onerror="this.style.background='#1a1a1a'" />
    <div class="c-card-overlay">
      <div class="c-card-read">▶</div>
      <div class="c-card-name">${book.title}</div>
      <div class="c-card-year">${volCount} Vol · ${pageCount} Pages</div>
    </div>`;
  card.addEventListener('click', () => cOpenModal(book));
  return card;
}

function cBuildRows() {
  const sec = document.getElementById('cRowsSection');
  sec.innerHTML = '';
  cCategories.forEach(cat => {
    const filtered = cBooks.filter(cat.filter);
    if (!filtered.length) return;
    const row = document.createElement('div');
    row.className = 'c-row';
    const id = 'cr-' + Math.random().toString(36).slice(2);
    row.innerHTML = `
      <div class="c-row-header"><span class="c-row-title">${cat.label}</span></div>
      <div class="c-row-scroll-wrap">
        <button class="c-row-btn left" onclick="cScrollRow('${id}',-1)">&#8249;</button>
        <div class="c-row-scroll" id="${id}"></div>
        <button class="c-row-btn right" onclick="cScrollRow('${id}',1)">&#8250;</button>
      </div>`;
    const scroll = row.querySelector('.c-row-scroll');
    filtered.forEach(b => scroll.appendChild(cMakeCard(b)));
    sec.appendChild(row);
  });
}

window.cScrollRow = (id, dir) => {
  const el = document.getElementById(id);
  if (el) el.scrollBy({ left: dir * 640, behavior: 'smooth' });
};

function cDoSearch() {
  const q = document.getElementById('cSearchInput').value.trim().toLowerCase();
  const sr = document.getElementById('cSearchResults');
  const rs = document.getElementById('cRowsSection');
  const hero = document.getElementById('cHero');
  if (!q) { sr.classList.remove('active'); rs.style.display = ''; hero.style.display = ''; return; }
  const filtered = cBooks.filter(b =>
    b.title.toLowerCase().includes(q) || b.genre.toLowerCase().includes(q) || b.year.includes(q)
  );
  hero.style.display = 'none'; rs.style.display = 'none'; sr.classList.add('active');
  const grid = document.getElementById('cSearchGrid');
  grid.innerHTML = '';
  if (!filtered.length) { grid.innerHTML = '<p style="color:#888;font-size:0.9rem;">No results found.</p>'; }
  else { filtered.forEach(b => grid.appendChild(cMakeCard(b))); }
}

let cActiveBtns = [];

function cOpenModal(book) {
  const readerWrap = document.getElementById('cBookReaderWrap');
  const chapterList = document.getElementById('cBookChapterList');
  readerWrap.innerHTML = '';
  chapterList.innerHTML = '';
  cActiveBtns = [];
  document.getElementById('cBookTitle').textContent = book.title;
  document.getElementById('cBookMeta').textContent = `${book.year} · ${book.genre}`;

if (book.id === 'chainsaw-man' || book.id === 'jujutsu-kaisen') {    document.getElementById('cBookCurrentTitle').textContent = 'Select a volume';
    Object.keys(book.chapters).sort((a, b) => +a - +b).forEach(volNum => {
      const chs = book.chapters[volNum];
      const lbl = document.createElement('div');
      lbl.className = 'c-book-volume-label';
      lbl.textContent = `Volume ${volNum}`;
      chapterList.appendChild(lbl);
      const btn = document.createElement('button');
      btn.className = 'c-book-btn';
      btn.textContent = `Volume ${volNum} (${chs.length} pages)`;
      btn.addEventListener('click', () => cLoadVolume(volNum, chs, btn));
      chapterList.appendChild(btn);
      cActiveBtns.push(btn);
    });
  } else {
    // Collect all pages into our global tracking array instantly
    cCurrentBookPages = Object.values(book.chapters).flat();
    cCurrentPageIndex = 0;

    document.getElementById('cBookCurrentTitle').textContent = 'Select a page';
    
    let globalIdx = 0;
    Object.keys(book.chapters).sort((a, b) => +a - +b).forEach(volNum => {
      const chs = book.chapters[volNum];
      const lbl = document.createElement('div');
      lbl.className = 'c-book-volume-label';
      lbl.textContent = Object.keys(book.chapters).length === 1 ? 'Pages' : `Volume ${volNum}`;
      chapterList.appendChild(lbl);
      
      chs.forEach(ch => {
        const currentIndex = globalIdx;
        const btn = document.createElement('button');
        btn.className = 'c-book-btn';
        btn.textContent = ch.title;
        btn.addEventListener('click', () => {
          cCurrentPageIndex = currentIndex;
          cShowPage(cCurrentPageIndex);
        });
        chapterList.appendChild(btn);
        cActiveBtns.push(btn);
        globalIdx++;
      });
    });

    // Render the very first page to start out
    if (cCurrentBookPages.length > 0) {
      cShowPage(0);
    }
  }

  document.getElementById('cModalOverlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function cLoadVolume(volNum, pages, activeBtn) {
  // Hand the pages array over to the global index controller
  cCurrentBookPages = pages;
  cCurrentPageIndex = 0;
  
  document.getElementById('cBookCurrentTitle').textContent = `Chainsaw Man - Volume ${volNum}`;
  cActiveBtns.forEach(b => b.classList.toggle('active', b === activeBtn));
  
  // Show the first page of the selected manga volume
  if (cCurrentBookPages.length > 0) {
    cShowPage(0);
  }
}

function cCloseModal() {
  document.getElementById('cBookReaderWrap').innerHTML = '';
  document.getElementById('cModalOverlay').classList.remove('open');
  document.body.style.overflow = '';
}
initMovies();
initShows();
initComics();

let cCurrentBookPages = [];
let cCurrentPageIndex = 0;

window.addEventListener('keydown', function(e) {
  const modal = document.getElementById('cModalOverlay');
  
  // Only activate if the comic viewer modal is wide open
  if (!modal || !modal.classList.contains('open')) return;

  const readerWrap = document.getElementById('cBookReaderWrap');
  if (!readerWrap || !cCurrentBookPages.length) return;

  // Handle Forward (Next Page): Right Arrow or Down Arrow
  if (e.key === "ArrowRight" || e.key === "ArrowDown") {
    if (cCurrentPageIndex < cCurrentBookPages.length - 1) {
      e.preventDefault(); // Stop webpage from jumping
      cCurrentPageIndex++;
      cShowPage(cCurrentPageIndex);
    }
  } 
  // Handle Backward (Previous Page): Left Arrow or Up Arrow
  else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
    if (cCurrentPageIndex > 0) {
      e.preventDefault(); // Stop webpage from jumping
      cCurrentPageIndex--;
      cShowPage(cCurrentPageIndex);
    }
  }
});

function cShowPage(index) {
  const readerWrap = document.getElementById('cBookReaderWrap');
  if (!readerWrap || !cCurrentBookPages || !cCurrentBookPages[index]) return;

  // Safe Sidebar Checking
  if (cActiveBtns && cActiveBtns.length > 0) {
    // Check if we are currently looking at Chainsaw Man 
    // (We know it's Chainsaw Man if the title bar says "Select a volume" or "Chainsaw Man")
    const topTitle = document.getElementById('cBookCurrentTitle').textContent || "";
const isChainsawMan = topTitle.toLowerCase().includes('chainsaw') || topTitle.toLowerCase().includes('jujutsu');
    if (isChainsawMan) {
      // KEEP THE SIDEBAR VOLUME BUTTON HIGHLIGHTED EXACTLY AS IT IS.
      // Just change the title text to show the page number so the user knows it's flipping!
      document.getElementById('cBookCurrentTitle').textContent = `Chainsaw Man - Page ${index + 1}`;
    } else {
      // Standard books (The Hunger Games, Batman, Invincible):
      // Highlight the exact page button in the sidebar like normal
      if (cActiveBtns[index]) {
        cActiveBtns.forEach((b, i) => b.classList.toggle('active', i === index));
        const pageTitle = cCurrentBookPages[index].title || `Page ${index + 1}`;
        document.getElementById('cBookCurrentTitle').textContent = pageTitle;
      }
    }
  }

  // Clear the reader viewport and load ONLY the single new page image
  readerWrap.innerHTML = '';
  
  const img = document.createElement('img');
  img.src = cCurrentBookPages[index].url.trim();
  img.alt = cCurrentBookPages[index].title || `Page ${index + 1}`;
  img.style.maxWidth = '100%';
  img.style.maxHeight = 'calc(92vh - 100px)';
  img.style.objectFit = 'contain';
  img.style.display = 'block';
  img.style.margin = '0 auto';
  
  readerWrap.appendChild(img);
  readerWrap.scrollTop = 0; // Snap view scroll position back to the top
}

function sShowHero(idx){
  // CHANGE 'shows.length' to 'vHeroShows.length'
  sHeroIndex = (idx + vHeroShows.length) % vHeroShows.length;
  
  // CHANGE 'shows[sHeroIndex]' to 'vHeroShows[sHeroIndex]'
  const s = vHeroShows[sHeroIndex];

  document.querySelectorAll('#sHeroSlides .hero-slide').forEach((el, i) => el.classList.toggle('active', i === sHeroIndex));
  document.querySelectorAll('#sHeroDots .hero-dot').forEach((el, i) => el.classList.toggle('active', i === sHeroIndex));
  

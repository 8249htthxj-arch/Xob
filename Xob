const G_PALETTES=[
  {top:'#0b2e12',mid:'#071a09',bot:'#040d05',accent:'#4ec96a'},
  {top:'#0b1e2e',mid:'#070f18',bot:'#04090d',accent:'#4eaecf'},
  {top:'#2e0b12',mid:'#1a0709',bot:'#0d0405',accent:'#cf4e5f'},
  {top:'#2a2a0b',mid:'#181807',bot:'#0c0c04',accent:'#c9c94e'},
  {top:'#1a0b2e',mid:'#0f0718',bot:'#09040d',accent:'#8b5ecf'},
  {top:'#2e1a0b',mid:'#180f07',bot:'#0d0904',accent:'#cf8b4e'},
];
function gGetPal(name){let h=0;for(let i=0;i<name.length;i++)h=(h*31+name.charCodeAt(i))>>>0;return G_PALETTES[h%G_PALETTES.length];}
function gCleanName(raw){return raw.replace(/^cl/i,'').replace(/\s+cl\s*$/i,'').replace(/([a-z])([A-Z])/g,'$1 $2').replace(/([A-Z])([A-Z][a-z])/g,'$1 $2').trim();}


function initShows(){
  const slidesEl = document.getElementById('sHeroSlides');
  const dotsEl = document.getElementById('sHeroDots');
  
  // Clear existing slides/dots to prevent duplicates
  slidesEl.innerHTML = '';
  dotsEl.innerHTML = '';

  // Only build slides for your handpicked list
  vHeroShows.forEach((s, i) => { 
    const sl = document.createElement('div'); 
    sl.className = 'hero-slide' + (i === 0 ? ' active' : '');
    sl.style.backgroundImage = `url('${s.backdrop}')`; 
    slidesEl.appendChild(sl);
    
    const d = document.createElement('button'); 
    d.className = 'hero-dot' + (i === 0 ? ' active' : '');
    d.addEventListener('click', () => sGoHero(i)); 
    dotsEl.appendChild(d);
  });


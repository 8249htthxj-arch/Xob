function buildShowRows(){
  const sec=document.getElementById('sRowsSection'); sec.innerHTML='';
  sCategories.forEach(cat=>{
    const filtered=shows.filter(cat.filter); if(!filtered.length) return;
    const row=document.createElement('div'); row.className='row';
    const id='sr-'+Math.random().toString(36).slice(2);
    row.innerHTML=`<div class="row-header"><span class="row-title">${cat.label}</span></div>
      <div class="row-scroll-wrap">
        <button class="row-btn left" onclick="sScrollRow('${id}',-1)">&#8249;</button>
        <div class="row-scroll" id="${id}"></div>
        <button class="row-btn right" onclick="sScrollRow('${id}',1)">&#8250;</button>
      </div>`;
    const scroll=row.querySelector('.row-scroll');
    filtered.forEach(s=>scroll.appendChild(sMakeCard(s))); sec.appendChild(row);
  });
}
window.sScrollRow=(id,dir)=>{const el=document.getElementById(id);if(el)el.scrollBy({left:dir*640,behavior:'smooth'});};

function sMakeCard(show){
  const card=document.createElement('div'); card.className='card';
  const sc=Object.keys(show.seasons).length;
  const te=Object.values(show.seasons).reduce((a,s)=>a+s.length,0);
  card.innerHTML=`<img class="card-poster" src="${show.poster}" alt="${show.title}" loading="lazy" onerror="this.style.background='#1a1a1a'" />
    <div class="card-overlay"><div class="card-play">&#9654;</div><div class="card-name">${show.title}</div><div class="card-year">${sc} Season${sc>1?'s':''} · ${te} Episodes</div></div>`;
  card.addEventListener('click',()=>sOpenModal(show)); return card;
}

function sOpenModal(show){
  const ep=document.getElementById('sEpPlayer'); ep.pause(); ep.src='';
  document.getElementById('sEpEpisodeList').innerHTML=[];
  document.getElementById('sEpShowTitle').textContent=show.title;
  document.getElementById('sEpShowMeta').textContent=`${show.year} · ${show.genre}`;
  document.getElementById('sEpCurrentTitle').textContent='Select an episode';
  const allEps=[];
  const epList=document.getElementById('sEpEpisodeList'); epList.innerHTML='';
  let activeBtns=[];
  Object.keys(show.seasons).forEach(sNum=>{
    const eps=show.seasons[sNum];
    const lbl=document.createElement('div'); lbl.className='ep-season-label';
    lbl.textContent=isNaN(sNum)?sNum:`Season ${sNum}`; epList.appendChild(lbl);
    eps.forEach(epItem=>{
      const idx=allEps.length; allEps.push(epItem);
      const btn=document.createElement('button'); btn.className='ep-btn'; btn.textContent=epItem.title;
      btn.addEventListener('click',()=>sPlayEpisode(epItem,idx,allEps,activeBtns));
      epList.appendChild(btn); activeBtns.push(btn);
    });
  });
  document.getElementById('sModalOverlay').classList.add('open');
  document.body.style.overflow='hidden';
  if(allEps.length) sPlayEpisode(allEps[0],0,allEps,activeBtns);
}

function sPlayEpisode(epItem,idx,allEps,activeBtns){
  const player=document.getElementById('sEpPlayer');
  if(!epItem.url){document.getElementById('sEpCurrentTitle').textContent=epItem.title+' (Not available)';return;}
  player.src=epItem.url.trim();
  document.getElementById('sEpCurrentTitle').textContent=epItem.title;
  activeBtns.forEach((b,i)=>b.classList.toggle('active',i===idx));
  player.load(); player.play().catch(()=>{});
  player.onended=()=>{if(idx+1<allEps.length)sPlayEpisode(allEps[idx+1],idx+1,allEps,activeBtns);};
  const ab=activeBtns[idx]; if(ab)ab.scrollIntoView({behavior:'smooth',block:'nearest'});
}

function sCloseModal(){
  const ep=document.getElementById('sEpPlayer'); ep.pause(); ep.src='';
  document.getElementById('sModalOverlay').classList.remove('open'); document.body.style.overflow='';
}
function sDoSearch(){
  const q=document.getElementById('sSearchInput').value.trim().toLowerCase();
  const sr=document.getElementById('sSearchResults'); const rs=document.getElementById('sRowsSection'); const hero=document.getElementById('sHero');
  if(!q){sr.classList.remove('active');rs.style.display='';hero.style.display='';return;}
  const filtered=shows.filter(s=>s.title.toLowerCase().includes(q)||s.genre.toLowerCase().includes(q)||s.year.includes(q));
  hero.style.display='none'; rs.style.display='none'; sr.classList.add('active');
  const grid=document.getElementById('sSearchGrid'); grid.innerHTML='';
  if(!filtered.length){grid.innerHTML='<p style="color:#888;">No results found.</p>';}
  else{filtered.forEach(s=>grid.appendChild(sMakeCard(s)));}
}


<script>
/* ══════════════════════════════
   TAB SWITCHING
══════════════════════════════ */
let activeTab = 'home';

function switchTab(name) {
  if (activeTab === name) return;
  activeTab = name;
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b.dataset.tab === name));
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + name));
  window.scrollTo(0, 0);

  const tabBar = document.getElementById('tabBar');
  if (name === 'home') {
    // On home page, always show the tab bar
    tabBar.classList.add('visible');
  } else {
    // On sub-panels, hide after a short moment
    clearTimeout(window._tabHideTimer);
    window._tabHideTimer = setTimeout(() => {
      tabBar.classList.remove('visible');
    }, 1800);
  }
}

/* ══════════════════════════════
   TAB BAR HOVER SHOW/HIDE
══════════════════════════════ */
(function() {
  const tabBar = document.getElementById('tabBar');
  const trigger = document.getElementById('tabBarTrigger');
  let hideTimeout;

  function showBar() {
    clearTimeout(hideTimeout);
    tabBar.classList.add('visible');
  }
  function scheduleHide() {
    clearTimeout(hideTimeout);
    hideTimeout = setTimeout(() => {
      if (activeTab !== 'home') tabBar.classList.remove('visible');
    }, 1400);
  }

  trigger.addEventListener('mouseenter', showBar);
  tabBar.addEventListener('mouseenter', showBar);
  tabBar.addEventListener('mouseleave', scheduleHide);
  // Also hide trigger when mouse leaves the trigger zone going downward
  trigger.addEventListener('mouseleave', (e) => {
    if (e.relatedTarget !== tabBar && !tabBar.contains(e.relatedTarget)) {
      scheduleHide();
    }
  });
})();


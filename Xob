let mHeroIndex=0, mHeroTimer=null;
const M_HERO_DURATION=7000;

function initMovies(){
  const slidesEl=document.getElementById('mHeroSlides');
  const dotsEl=document.getElementById('mHeroDots');
  mHeroMovies.forEach((m,i)=>{
    const s=document.createElement('div'); s.className='hero-slide'+(i===0?' active':'');
    s.style.backgroundImage=`url('${m.backdrop}')`; slidesEl.appendChild(s);
    const d=document.createElement('button'); d.className='hero-dot'+(i===0?' active':'');
    d.addEventListener('click',()=>mGoHero(i)); dotsEl.appendChild(d);
  });
  mShowHero(0); mResetProgress();
  document.getElementById('mHeroPrev').addEventListener('click',()=>mGoHero(mHeroIndex-1));
  document.getElementById('mHeroNext').addEventListener('click',()=>mGoHero(mHeroIndex+1));
  buildMovieRows();
  document.getElementById('mSearchInput').addEventListener('input',mDoSearch);
  document.getElementById('mModalClose').addEventListener('click',mCloseModal);
  document.getElementById('mModalOverlay').addEventListener('click',e=>{if(e.target===document.getElementById('mModalOverlay'))mCloseModal();});
  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&activeTab==='movies')mCloseModal();});
}

function mShowHero(idx){
  mHeroIndex=(idx+mHeroMovies.length)%mHeroMovies.length;
  const m=mHeroMovies[mHeroIndex];
  document.querySelectorAll('#mHeroSlides .hero-slide').forEach((s,i)=>s.classList.toggle('active',i===mHeroIndex));
  document.querySelectorAll('#mHeroDots .hero-dot').forEach((d,i)=>d.classList.toggle('active',i===mHeroIndex));
  document.getElementById('mHeroTitle').textContent=m.title;
  document.getElementById('mHeroYear').textContent=m.year;
  document.getElementById('mHeroGenre').textContent=m.genre;
  document.getElementById('mHeroDesc').textContent=m.description;
  document.getElementById('mHeroPlayBtn').onclick=()=>mOpenModal(m);
  document.getElementById('mHeroInfoBtn').onclick=()=>mOpenModal(m);
}
function mGoHero(idx){mShowHero(idx);mResetProgress();}
function mResetProgress(){
  clearTimeout(mHeroTimer);
  const bar=document.getElementById('mHeroProgressBar');
  bar.style.transition='none'; bar.style.width='0%'; bar.offsetHeight;
  bar.style.transition=`width ${M_HERO_DURATION}ms linear`; bar.style.width='100%';
  mHeroTimer=setTimeout(()=>mGoHero(mHeroIndex+1),M_HERO_DURATION);
}

function buildMovieRows(){
  const sec=document.getElementById('mRowsSection'); sec.innerHTML='';
  mCategories.forEach(cat=>{
    const filtered=movies.filter(cat.filter); if(filtered.length<2) return;
    const row=document.createElement('div'); row.className='row';
    const id='mr-'+Math.random().toString(36).slice(2);
    row.innerHTML=`<div class="row-header"><span class="row-title">${cat.label}</span></div>
      <div class="row-scroll-wrap">
        <button class="row-btn left" onclick="mScrollRow('${id}',-1)">&#8249;</button>
        <div class="row-scroll" id="${id}"></div>
        <button class="row-btn right" onclick="mScrollRow('${id}',1)">&#8250;</button>
      </div>`;
    const scroll=row.querySelector('.row-scroll');
    filtered.forEach(m=>scroll.appendChild(mMakeCard(m))); sec.appendChild(row);
  });
}
window.mScrollRow=(id,dir)=>{const el=document.getElementById(id);if(el)el.scrollBy({left:dir*640,behavior:'smooth'});};

function mMakeCard(movie){
  const card=document.createElement('div'); card.className='card';
  card.innerHTML=`<img class="card-poster" src="${movie.poster}" alt="${movie.title}" loading="lazy" onerror="this.style.background='#1a1a1a'" />
    <div class="card-overlay"><div class="card-play">&#9654;</div><div class="card-name">${movie.title}</div><div class="card-year">${movie.year}</div></div>`;
  card.addEventListener('click',()=>mOpenModal(movie)); return card;
}

function mOpenModal(movie){
  const bg=document.getElementById('mModalBg'); bg.style.backgroundImage=`url('${movie.backdrop||movie.poster}')`;
  const vid=document.getElementById('mModalVideo'); vid.style.display='none'; vid.src='';
  document.getElementById('mModalHero').classList.remove('modal-playing');
  document.getElementById('mModalPlayOverlay').style.display='flex';
  document.getElementById('mModalPoster').src=movie.poster;
  document.getElementById('mModalTitle').textContent=movie.title;
  document.getElementById('mModalMetaRow').innerHTML=`<span class="modal-badge">HD</span><span class="modal-year">${movie.year}</span>${movie.genre.split(',').map(g=>`<span class="modal-genre-tag">${g.trim()}</span>`).join('')}`;
  document.getElementById('mModalDesc').textContent=movie.description;
  const startPlay=()=>{bg.style.display='none';vid.src=movie.video;vid.style.display='block';document.getElementById('mModalHero').classList.add('modal-playing');document.getElementById('mModalPlayOverlay').style.display='none';vid.play().catch(()=>{});};
  document.getElementById('mModalPlayOverlay').onclick=startPlay;
  document.getElementById('mModalPlayBtn').onclick=startPlay;
  document.getElementById('mModalOverlay').classList.add('open');
  document.body.style.overflow='hidden';
}
function mCloseModal(){
  const vid=document.getElementById('mModalVideo'); vid.pause(); vid.src=''; vid.style.display='none';
  document.getElementById('mModalBg').style.display=''; document.getElementById('mModalOverlay').classList.remove('open');
  document.body.style.overflow='';
}
function mDoSearch(){
  const q=document.getElementById('mSearchInput').value.trim().toLowerCase();
  const sr=document.getElementById('mSearchResults'); const rs=document.getElementById('mRowsSection'); const hero=document.getElementById('mHero');
  if(!q){sr.classList.remove('active');rs.style.display='';hero.style.display='';return;}
  const filtered=movies.filter(m=>m.title.toLowerCase().includes(q)||m.genre.toLowerCase().includes(q)||String(m.year).includes(q));
  hero.style.display='none'; rs.style.display='none'; sr.classList.add('active');
  const grid=document.getElementById('mSearchGrid'); grid.innerHTML='';
  if(!filtered.length){grid.innerHTML='<p style="color:#888;font-size:0.9rem;">No results found.</p>';}
  else{filtered.forEach(m=>grid.appendChild(mMakeCard(m)));}
}

